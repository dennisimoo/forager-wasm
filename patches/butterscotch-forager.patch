+static RValue builtin_screen_save_part(VMContext* ctx, RValue* args, int32_t argCount) {
+    REQUIRE_ARGC_AT_LEAST("screen_save_part", 5, RValue_makeBool(false));
+    Runner* runner = ctx->runner;
+    Renderer* renderer = runner->renderer;
+    int32_t surface = runner->applicationSurfaceId;
+    if (renderer == nullptr || renderer->vtable->surfaceGetPixels == nullptr ||
+        !Renderer_surfaceExists(renderer, surface)) return RValue_makeBool(false);
+    int32_t sw = (int32_t)Renderer_getSurfaceWidth(renderer, surface);
+    int32_t sh = (int32_t)Renderer_getSurfaceHeight(renderer, surface);
+    int32_t x = RValue_toInt32(args[1]), y = RValue_toInt32(args[2]);
+    int32_t w = RValue_toInt32(args[3]), h = RValue_toInt32(args[4]);
+    if (sw <= 0 || sh <= 0 || x < 0 || y < 0 || w <= 0 || h <= 0 ||
+        x > sw || y > sh || w > sw - x || h > sh - y) return RValue_makeBool(false);
+    uint8_t* pixels = (uint8_t*)safeMalloc((size_t)sw * sh * 4);
+    if (!renderer->vtable->surfaceGetPixels(renderer, surface, pixels)) {
+        free(pixels);
+        return RValue_makeBool(false);
+    }
+    uint8_t* cropped = (uint8_t*)safeMalloc((size_t)w * h * 4);
+    for (int32_t row = 0; row < h; row++) {
+        memcpy(cropped + (size_t)row * w * 4, pixels + ((size_t)(y + row) * sw + x) * 4, (size_t)w * 4);
+    }
+    free(pixels);
+    size_t pngSize = 0;
+    void* png = tdefl_write_image_to_png_file_in_memory(cropped, w, h, 4, &pngSize);
+    free(cropped);
+    if (png == nullptr) return RValue_makeBool(false);
+    char* path = RValue_toString(args[0], ctx->dataWin);
+    bool saved = runner->fileSystem->vtable->writeFileBinary(runner->fileSystem, path, png, pngSize);
+    free(path);
+    free(png);
+    return RValue_makeBool(saved);
 }
 
