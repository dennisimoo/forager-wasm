+#[cfg(test)]
+mod aulldvrm_tests {
+    use super::*;
+    fn eval(expr: &Expr, regs: &[u64; 8], args: &[u8]) -> u64 {
+        match expr {
+            Expr::Read(Location::Reg(RegId(r))) => regs[*r as usize],
+            Expr::Const(v, _) => *v as u64,
+            Expr::Load { addr, .. } => {
+                let at = eval(addr, regs, args) as usize;
+                u64::from_le_bytes(args[at..at+8].try_into().unwrap())
+            }
+            Expr::Binary(op, left, right) => {
+                let a = eval(left, regs, args); let b = eval(right, regs, args);
+                match op { BinOp::Add => a+b, BinOp::UDiv => a/b, BinOp::UMod => a%b,
+                    BinOp::And => a&b, BinOp::Shr => a>>b, _ => panic!("unexpected operation") }
+            }
+            _ => panic!("unexpected expression"),
+        }
+    }
+    #[test]
+    fn unsigned_division_preserves_all_four_result_registers() {
+        for (n,d) in [(12345u64,10u64), (u64::MAX,10), (u64::MAX,0x100000003),
+                      (0x8000000123456789,0x200000000), (0,7), (7,8), (u64::MAX,1)] {
+            let args: Vec<u8> = n.to_le_bytes().into_iter().chain(d.to_le_bytes()).collect();
+            let mut regs = [0,0,0,0,0,42,43,44];
+            for stmt in lower_aulldvrm(MSVC_AULLDVRM).unwrap() {
+                if let Stmt::Set { dst: Location::Reg(RegId(r)), expr } = stmt {
+                    regs[r as usize] = eval(&expr, &regs, &args);
+                } else { panic!("unexpected statement"); }
+            }
+            assert_eq!((regs[2]<<32)|regs[0], n/d);
+            assert_eq!((regs[3]<<32)|regs[1], n%d);
+            assert_eq!(&regs[4..], &[16,42,43,44]);
+        }
+    }
+    #[test]
+    fn different_or_truncated_helpers_are_not_replaced() {
+        assert!(lower_aulldvrm(&MSVC_AULLDVRM[..MSVC_AULLDVRM.len()-1]).is_none());
+        let mut changed = MSVC_AULLDVRM.to_vec(); changed[20] ^= 1;
+        assert!(lower_aulldvrm(&changed).is_none());
+    }
+}
