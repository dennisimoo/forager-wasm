+fn lower_aulldvrm(bytes: &[u8]) -> Option<Vec<Stmt>> {
+    if !bytes.starts_with(MSVC_AULLDVRM) { return None; }
+    let sp = Location::Reg(RegId(4));
+    let load = |offset| Expr::Load {
+        addr: Box::new(Expr::Binary(BinOp::Add, Box::new(Expr::Read(sp.clone())), Box::new(Expr::konst(offset, 32)))),
