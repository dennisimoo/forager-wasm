+        for function in &mut functions { thread_internal_call_esp(function); crate::ssa::to_ssa(function); crate::opt::optimize(function); }
+        for structured in [false, true] {
+            let mut forward = BTreeSet::new();
+            let body: String = functions.iter().map(|function| if structured {
+                crate::emit::structured::emit_function(function, &mut forward, true)
+            } else { crate::emit::emit_function(function, &mut forward, true) }).collect();
+            let source = format!("#include <stdint.h>\n#include <math.h>\n{}\n{}\nint main(void){{return (uint32_t)sub_1000(0,0,0,0,0,0,0,0)!=1 || (uint32_t)sub_1000(0,0,1,0,0,0,0,0)!=UINT32_MAX;}}\n", crate::emit::float_preamble(&body), body);
