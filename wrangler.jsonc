{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forager-wasm",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-09",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "r2_buckets": [
    {
      "binding": "GAME_ASSETS",
      "bucket_name": "forager-wasm-assets",
    },
  ],
}
